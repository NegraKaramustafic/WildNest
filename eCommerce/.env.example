# Local process environment. Copy to .env and fill in real values.
# .env is gitignored. Do not commit secrets.

ASPNETCORE_ENVIRONMENT=Development

# SQL Server. Database name is the student index without the IB prefix.
# localhost,1435 is the published Docker port used by `dotnet run`.
# DB_NAME is the only database name. Startup replaces Database= with DB_NAME
# (${DB_NAME} below is a placeholder, not a second copy of the name).
MSSQL_SA_PASSWORD=qweasd123!
DB_NAME=230080
ConnectionStrings__DefaultConnection=Server=localhost,1435;Database=${DB_NAME};User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;

JwtToken__SecretKey=replace-with-a-random-secret-at-least-32-characters
JwtToken__Issuer=https://eCommerce.com
JwtToken__Audience=http://eCommerce.com
JwtToken__DurationInMinutes=30

RABBITMQ_HOSTNAME=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUENAME=wildnest.notifications

# Leave SMTP_HOST empty to log notification emails instead of sending them.
# `docker compose` points the subscriber at Mailpit (http://localhost:8025, SMTP port 1025, no SSL)
# so reset codes and reminders can be read in a browser. These values are for `dotnet run` on the host.
# To catch host-process mail locally, set SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_FROM=noreply@wildnest.local, SMTP_ENABLE_SSL=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# Password reset codes. Defaults are used when a variable is omitted.
PASSWORD_RESET_CODE_LIFETIME_MINUTES=15
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5

# Sign-in and password-reset rate limits. Fixed window, per IP and per account.
# Defaults allow a normal demo (several mistyped passwords, one or two reset emails).
# Omit a variable to keep its default. Each value must be a positive integer.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_PER_IP=30
AUTH_RATE_LIMIT_LOGIN_PER_ACCOUNT=10
AUTH_RATE_LIMIT_REFRESH_PER_IP=60
AUTH_RATE_LIMIT_REFRESH_PER_ACCOUNT=20
AUTH_RATE_LIMIT_FORGOT_PASSWORD_PER_IP=10
AUTH_RATE_LIMIT_FORGOT_PASSWORD_PER_ACCOUNT=5
AUTH_RATE_LIMIT_RESET_PASSWORD_PER_IP=20
AUTH_RATE_LIMIT_RESET_PASSWORD_PER_ACCOUNT=10

# Upcoming schedule reminders. The background job is off the request path.
# Shorten these only while demonstrating; the defaults are the normal values.
REMINDER_HOURS_BEFORE=24
REMINDER_CHECK_INTERVAL_MINUTES=15

# Stripe test/sandbox keys. Never commit live keys. Webhook secret comes from
# `stripe listen --forward-to http://localhost:5126/api/Payment/webhook`.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=eur
STRIPE_SUCCESS_URL=wildnest://payment-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=wildnest://payment-cancel

# Comma-separated browser origins. Flutter desktop and mobile are not subject to CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5126

# IANA time zone used for zoo-local "today" (schedules and ticket visits).
ZOO_TIME_ZONE=Europe/Sarajevo

# Optional path for the shipped binary sentiment model. When unset, the API
# loads ml-models/review-sentiment.zip next to the application. It does not
# train at startup. A missing file leaves new reviews unlabeled.
# SENTIMENT_MODEL_PATH=

# How often the background job retrains the reservation recommender, and how
# many new confirmed or completed reservations trigger an earlier retrain.
# RECOMMENDATION_RETRAIN_INTERVAL_MINUTES=360
# RECOMMENDATION_RETRAIN_AFTER_NEW_RESERVATIONS=10
# RECOMMENDATION_TRAINING_CHECK_MINUTES=5
